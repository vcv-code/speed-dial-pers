{
  "manifest_version": 3,
  "name": "Mi Speed Dial",
  "version": "1.0",
  "description": "Nueva pestaña personalizada",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}